# ========================================================
# Hera Environment Configuration
# ========================================================

# Host directory where music will be downloaded and saved
# Default: ./music
MUSIC_DIR=./music

# Host directory where configuration (settings.json) will be stored
# Default: ./config
CONFIG_DIR=./config

# Optional initial credentials (can also be configured via Web UI at http://localhost:8080)
# LASTFM_API_KEY=
# LASTFM_USERNAME=