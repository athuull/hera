<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>downtify</Name>
  <Repository>henriquesebastiao/downtify:latest</Repository>
  <Registry>https://hub.docker.com/r/henriquesebastiao/downtify</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>

  <Icon>https://raw.githubusercontent.com/athuull/hera/main/src/main/resources/static/favicon.png</Icon>
  <WebUI>http://[IP]:[PORT:8000]</WebUI>

  <Overview>Downtify is an open-source Spotify and YouTube Music downloader backend powered by FastAPI, yt-dlp, and ffmpeg. It provides an automated download engine and queue management for companion clients like Hera.</Overview>

  <Support>https://github.com/henriquesebastiao/downtify/issues</Support>
  <Project>https://github.com/henriquesebastiao/downtify</Project>
  <TemplateURL>https://raw.githubusercontent.com/athuull/hera/main/templates/downtify.xml</TemplateURL>

  <Category>MediaApp:Music MediaApp:Other Tools:Utilities</Category>
  <Changes>Companion Downtify container for Hera</Changes>
  <Date>2026-09-13</Date>
  <License>GPLv3</License>

  <Config Name="API Port" Target="8000" Default="8000" Mode="tcp" Description="HTTP port for Downtify API" Type="Port" Display="always" Required="true" Mask="false"/>
  <Config Name="Downloads Directory" Target="/downloads" Default="/mnt/user/data/media/music" Mode="rw" Description="Download directory where files will be stored (must match Hera's music download directory)" Type="Path" Display="always" Required="true" Mask="false"/>
</Container>
