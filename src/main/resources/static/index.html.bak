<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>hera</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script>
        (function() {
            try {
                if (localStorage.getItem('hera-theme') === 'light') {
                    document.documentElement.setAttribute('data-theme', 'light');
                }
            } catch (e) {}
        })();
    </script>
    <style>
        :root {
            --bg: #0e1015; --surface: #14171f; --surface-elevated: #1a1e29;
            --border: #262a36; --border-focus: #4e5569;
            --text: #e2e5ec; --text-muted: #828a9c; --text-dim: #545b6d;
            --heading-color: #ffffff;
            --btn-bg: #1c202b; --btn-border: #2d3345; --btn-hover: #262c3c; --btn-active: #31384c;
            --pre-bg: #090a0d; --pre-text: #abb2bf;
            --status-ok: #34d399; --status-warn: #fbbf24; --status-err: #f87171;
            --tr-hover: rgba(255, 255, 255, 0.025);
            --progress-track-bg: rgba(255, 255, 255, 0.06);
            --font-mono: 'JetBrains Mono', 'Fira Code', 'SF Mono', Consolas, Monaco, monospace;
        }

        [data-theme="light"] {
            --bg: #faf8f5; --surface: #f5f0eb; --surface-elevated: #ede7e0;
            --border: #ddd5cb; --border-focus: #b0a899;
            --text: #2c2418; --text-muted: #6b5e50; --text-dim: #9a8e80;
            --heading-color: #1a1208;
            --btn-bg: #ede7e0; --btn-border: #d4cbc0; --btn-hover: #e4dcd3; --btn-active: #d4cbc0;
            --pre-bg: #f2ece5; --pre-text: #3d3224;
            --status-ok: #10b981; --status-warn: #d97706; --status-err: #ef4444;
            --tr-hover: rgba(0, 0, 0, 0.03);
            --progress-track-bg: #ddd5cb;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: var(--font-mono); font-size: 14px; background: var(--bg);
            color: var(--text); padding: 24px; line-height: 1.6; text-transform: lowercase;
            max-width: 1200px; margin: 0 auto;
            transition: background 0.15s ease, color 0.15s ease;
        }
        h1, h2, h3 { font-weight: 700; letter-spacing: -0.02em; color: var(--heading-color); }
        h1 { font-size: 28px; letter-spacing: -0.03em; display: inline-block; }
        h2 {
            font-size: 18px; margin-bottom: 14px; color: var(--heading-color);
            display: flex; align-items: center; gap: 10px;
        }
        h2::before { content: "::"; color: var(--text-dim); font-weight: 600; font-size: 18px; }
        hr { border: 0; border-top: 1px solid var(--border); margin: 24px 0; }

        .header-bar { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
        .status-bar { font-size: 13px; color: var(--text-muted); }
        .status-pill { font-weight: 600; }
        .status-pill.connected { color: var(--status-ok); }
        .status-pill.disconnected { color: var(--status-err); }
        .status-pill.connecting, .status-pill.active { color: var(--status-warn); }
        .status-pill.idle { color: var(--text-dim); }
        .header-actions { display: flex; align-items: center; gap: 8px; }

        input, select, button {
            font-family: var(--font-mono); font-size: 13.5px; border: 1px solid var(--btn-border);
            background: var(--surface); color: var(--text); padding: 7px 12px; text-transform: lowercase;
            border-radius: 4px; outline: none; transition: all 0.15s ease;
        }
        input:focus, select:focus {
            border-color: var(--border-focus); box-shadow: 0 0 0 1px var(--border-focus); background: var(--surface-elevated);
        }
        button { cursor: pointer; background: var(--btn-bg); border: 1px solid var(--btn-border); font-weight: 600; color: var(--text); }
        button:hover:not(:disabled) { background: var(--btn-hover); border-color: var(--border-focus); color: var(--heading-color); }
        button:active:not(:disabled) { background: var(--btn-active); transform: translateY(1px); }
        button:disabled { opacity: 0.45; cursor: not-allowed; }
        input[type="checkbox"] { width: 15px; height: 15px; accent-color: #6366f1; cursor: pointer; vertical-align: middle; }
        .hidden { display: none !important; }

        details { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 12px 16px; }
        details[open] { padding-bottom: 16px; }
        summary { cursor: pointer; font-size: 16px; font-weight: 600; color: var(--text); user-select: none; outline: none; }
        summary:hover { color: var(--heading-color); }
        .settings-content { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--border); }
        fieldset { border: 0; padding: 0; }
        .setting-row { margin-bottom: 14px; }
        .setting-row label { display: block; margin-bottom: 5px; color: var(--text-muted); font-size: 12.5px; }
        .setting-toggle { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; cursor: pointer; user-select: none; }

        .search-panel, .search-group, .results-toolbar, .library-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .search-group { gap: 8px; }
        .results-toolbar { margin-bottom: 12px; }

        .table-container { width: 100%; overflow-x: auto; border: 1px solid var(--border); border-radius: 6px; background: var(--surface); }
        table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
        th, td { padding: 10px 14px; border-bottom: 1px solid var(--border); vertical-align: middle; }
        th { background: var(--surface-elevated); color: var(--text-muted); font-weight: 600; border-bottom: 1px solid var(--border-focus); }
        tr:last-child td { border-bottom: 0; }
        .tag-pill { font-size: 11.5px; padding: 2px 6px; background: var(--btn-bg); border: 1px solid var(--border); border-radius: 3px; color: var(--text-muted); }
        .status-badge { font-size: 11px; padding: 2px 6px; border-radius: 3px; font-weight: 600; }
        .status-badge.success { background: rgba(52, 211, 153, 0.15); color: var(--status-ok); border: 1px solid rgba(52, 211, 153, 0.3); }
        .status-badge.failed { background: rgba(248, 113, 113, 0.15); color: var(--status-err); border: 1px solid rgba(248, 113, 113, 0.3); }
        .status-badge.skipped { background: rgba(130, 138, 156, 0.15); color: var(--text-muted); border: 1px solid var(--border); }
        .source-badge { font-size: 11px; padding: 2px 6px; border-radius: 3px; background: var(--surface-elevated); border: 1px solid var(--border); color: var(--text-muted); }

        .loading-pulse {
            display: inline-flex; align-items: center; gap: 10px; color: var(--text-muted); font-size: 13px;
            padding: 16px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: 6px; width: 100%;
        }
        .loading-pulse .spinner-frame { color: var(--status-warn); font-weight: 700; display: inline-block; font-family: var(--font-mono); min-width: 28px; }

        pre {
            background: var(--pre-bg); border: 1px solid var(--border); border-radius: 6px; padding: 14px;
            white-space: pre-wrap; word-wrap: break-word; max-height: 280px; overflow-y: auto; color: var(--pre-text); font-size: 12.5px; line-height: 1.6;
        }
        pre::-webkit-scrollbar { width: 6px; height: 6px; }
        pre::-webkit-scrollbar-track { background: transparent; }
        pre::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        .library-list-box { background: var(--surface); border: 1px solid var(--border); border-radius: 6px; padding: 12px; max-height: 320px; overflow-y: auto; }
        .library-list-box ul { list-style: none; }
        .library-list-box li { padding: 6px 8px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; font-size: 13px; }
        .library-list-box li::before { content: ">"; color: var(--text-dim); font-weight: bold; }
        .library-list-box li:last-child { border-bottom: 0; }
        .track-thumb { width: 24px; height: 24px; border-radius: 3px; object-fit: cover; border: 1px solid var(--border); flex-shrink: 0; }
        #status-text { margin-top: 14px; font-size: 13px; color: var(--status-ok); }

        /* Progress Dashboard */
        .progress-dashboard {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-bottom: 14px;
        }
        @media (max-width: 768px) {
            .progress-dashboard { grid-template-columns: 1fr; }
        }
        .progress-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            position: relative;
            overflow: hidden;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .progress-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; height: 2px;
            background: var(--border);
            transition: background 0.2s ease, box-shadow 0.2s ease;
        }
        .progress-card.active::before {
            background: var(--status-ok);
            box-shadow: 0 0 8px var(--status-ok);
        }
        .progress-card.active {
            border-color: var(--border-focus);
        }
        .progress-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .progress-card-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-dim);
        }
        .progress-track-name {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-height: 20px;
        }
        .progress-bar-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            background: var(--pre-bg);
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 12px;
            font-family: var(--font-mono);
            width: 100%;
        }
        .progress-track {
            flex: 1;
            height: 14px;
            background: var(--progress-track-bg);
            border: 1px solid var(--border);
            border-radius: 3px;
            overflow: hidden;
            position: relative;
        }
        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #059669, #34d399);
            border-radius: 2px;
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 0 8px rgba(52, 211, 153, 0.35);
            position: relative;
        }
        [data-theme="light"] .progress-fill {
            background: linear-gradient(90deg, #16a34a, #22c55e);
            box-shadow: 0 0 6px rgba(34, 197, 94, 0.35);
        }
        .progress-fill::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: repeating-linear-gradient(
                90deg,
                transparent,
                transparent 4px,
                rgba(0, 0, 0, 0.12) 4px,
                rgba(0, 0, 0, 0.12) 6px
            );
            pointer-events: none;
        }
        .progress-bar-pct {
            font-size: 13px;
            font-weight: 700;
            color: var(--status-ok);
            min-width: 44px;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }
        .progress-subtext {
            font-size: 11.5px;
            color: var(--text-muted);
            min-height: 18px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .progress-log-container {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 6px;
            overflow: hidden;
        }
        .progress-log-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 7px 12px;
            background: var(--surface-elevated);
            border-bottom: 1px solid var(--border);
            font-size: 11.5px;
            color: var(--text-muted);
        }
        .progress-log-container pre {
            border: 0;
            border-radius: 0;
            max-height: 120px;
            padding: 10px 12px;
            font-size: 12px;
            margin: 0;
        }

        footer { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--border); display: flex; justify-content: center; align-items: center; }
        .github-link { display: inline-flex; align-items: center; color: var(--text-dim); text-decoration: none; transition: color 0.15s ease, transform 0.15s ease; }
        .github-link:hover { color: var(--text); transform: translateY(-1px); }
    </style>
</head>
<body>

<header class="header-bar">
    <div>
        <h1>hera</h1>
        <span style="color: var(--text-dim); margin-left: 10px; font-size: 14.5px;">// music recommendations &amp; downloader</span>
    </div>
    <div class="header-actions">
        <div class="status-bar">ws: <span id="ws-text" class="status-pill connecting">[connecting...]</span></div>
        <button id="theme-toggle-btn" onclick="toggleTheme()" title="toggle light / dark mode">[light mode]</button>
        <button onclick="triggerSchedule()" title="trigger scheduled auto-download right now">[auto-download now]</button>
    </div>
</header>

<hr>

<details id="settings-details">
    <summary>settings</summary>
    <div class="settings-content">
        <fieldset>
            <div class="setting-row">
                <label>last.fm api key:</label>
                <input type="password" id="set-lastfm-key" style="width: 100%; max-width: 500px;" placeholder="last.fm api key">
            </div>
            <div class="setting-row">
                <label>last.fm username:</label>
                <input type="text" id="set-lastfm-user" style="width: 100%; max-width: 320px;" placeholder="username">
            </div>
            <div class="setting-row">
                <label>scheduled daily limit (nightly):</label>
                <input type="number" id="set-max-downloads" min="1" max="500" value="5" style="width: 90px;">
            </div>
            <div class="setting-row">
                <label>auto-download strategy:</label>
                <select id="set-strategy">
                    <option value="HYBRID">hybrid (my profile)</option>
                    <option value="USER_PERSONALIZED">my top artists</option>
                    <option value="NOW_LISTENING">now listening</option>
                    <option value="GENRE_BASED">my top genres</option>
                </select>
            </div>
            <div class="setting-row">
                <label>auto-download time (24h):</label>
                <select id="set-cron-hour"></select>
                <span style="margin: 0 4px;">:</span>
                <select id="set-cron-minute"></select>
            </div>
            <div class="setting-row">
                <label>format &amp; bitrate:</label>
                <select id="set-format">
                    <option value="mp3">mp3</option>
                    <option value="flac">flac</option>
                    <option value="m4a">m4a</option>
                    <option value="opus">opus</option>
                </select>
                <select id="set-bitrate" style="margin-left: 6px;">
                    <option value="320">320</option>
                    <option value="256">256</option>
                    <option value="192">192</option>
                    <option value="128">128</option>
                </select>
            </div>
            <div style="margin-top: 14px;">
                <label class="setting-toggle" for="set-organize">
                    <input type="checkbox" id="set-organize">
                    <span>organize by artist</span>
                </label>
                <label class="setting-toggle" for="set-lyrics">
                    <input type="checkbox" id="set-lyrics">
                    <span>download lyrics (.lrc)</span>
                </label>
                <label class="setting-toggle" for="set-cover-art">
                    <input type="checkbox" id="set-cover-art" checked>
                    <span>download cover art</span>
                </label>
            </div>
            <div class="setting-row" style="margin-top: 10px;">
                <label>cover resolution (px):</label>
                <select id="set-cover-resolution">
                    <option value="300">300x300</option>
                    <option value="600" selected>600x600 (recommended)</option>
                    <option value="800">800x800</option>
                    <option value="1200">1200x1200 (hq)</option>
                </select>
            </div>
            <div style="margin-top: 16px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                <button id="save-settings-btn" onclick="saveSettings()">[save settings]</button>
                <button id="cleanup-btn" onclick="triggerCleanup()">[cleanup webm]</button>
                <span id="settings-status" style="font-size: 12px; font-weight: 500;"></span>
            </div>
        </fieldset>
    </div>
</details>

<hr>

<h2>find music</h2>
<div class="search-panel">
    <div class="search-group">
        <label>discovery strategy:</label>
        <select id="strategy" onchange="toggleSeedInput()">
            <option value="HYBRID">hybrid (my profile)</option>
            <option value="USER_PERSONALIZED">my top artists</option>
            <option value="NOW_LISTENING">now listening</option>
            <option value="GENRE_BASED">my top genres</option>
            <option value="ARTIST_SIMILARITY">by artist</option>
            <option value="TRACK_SIMILARITY">by track</option>
            <option value="TAG_BASED">by tag</option>
        </select>
    </div>
    <div class="search-group">
        <label>limit:</label>
        <input type="number" id="limit" value="20" min="1" max="100" style="width: 70px;">
    </div>
    <div id="seed-group" class="search-group hidden">
        <label id="seed-label">search term:</label>
        <input type="text" id="seed" style="width: 280px;">
    </div>
    <button id="search-btn" onclick="searchRecommendations()">[discover recommendations]</button>
</div>
<div class="url-download-panel" style="margin-top: 10px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
    <input type="text" id="direct-search-input" placeholder="search song name (e.g. family ties) or paste link..." style="flex: 1; min-width: 280px; max-width: 520px;" onkeydown="handleDirectInputKey(event)">
    <button id="direct-search-btn" onclick="handleDirectSearch()">[search songs]</button>
    <button id="download-url-btn" onclick="downloadByUrl()">[download link]</button>
    <span id="direct-search-status" style="font-size: 12px; font-weight: 500;"></span>
</div>

<hr>

<h2 id="results-heading">results</h2>
<div id="results-actions" class="results-toolbar hidden">
    <button onclick="selectAll(true)">[select all]</button>
    <button onclick="selectAll(false)">[deselect all]</button>
    <button id="download-selected-btn" onclick="downloadSelected()">[download selected]</button>
    <span id="selected-count-label" style="color: var(--text-muted); margin-left: 8px;"></span>
</div>
<div id="results-table">
    <p style="color: var(--text-muted);">no results yet.</p>
</div>

<hr>

<h2>download progress <span id="download-status" class="status-pill idle" style="font-size: 12px; font-weight: normal; margin-left: 6px;">[idle]</span></h2>

<div class="progress-dashboard">
    <!-- Left Card: Current Track Download Progress -->
    <div class="progress-card" id="card-track">
        <div class="progress-card-header">
            <span class="progress-card-title">current track</span>
            <span id="track-status-pill" class="status-pill idle">[idle]</span>
        </div>
        <div id="track-name-display" class="progress-track-name" title="no active download">no active download</div>
        <div class="progress-bar-container">
            <div class="progress-track" id="track-progress-track">
                <div id="track-progress-fill" class="progress-fill" style="width: 0%;"></div>
            </div>
            <span id="track-progress-pct" class="progress-bar-pct">0%</span>
        </div>
        <div id="track-subtext" class="progress-subtext">waiting for download job...</div>
    </div>

    <!-- Right Card: Batch Download Progress (To the side) -->
    <div class="progress-card" id="card-batch">
        <div class="progress-card-header">
            <span class="progress-card-title">batch progress</span>
            <span id="batch-status-pill" class="status-pill idle">[idle]</span>
        </div>
        <div id="batch-count-display" class="progress-track-name">0 / 0 tracks</div>
        <div class="progress-bar-container">
            <div class="progress-track" id="batch-progress-track">
                <div id="batch-progress-fill" class="progress-fill" style="width: 0%;"></div>
            </div>
            <span id="batch-progress-pct" class="progress-bar-pct">0%</span>
        </div>
        <div id="batch-subtext" class="progress-subtext">no active batch</div>
    </div>
</div>

<!-- Compact Activity Feed -->
<div class="progress-log-container">
    <div class="progress-log-header">
        <span>activity feed</span>
        <button onclick="clearProgress()" style="padding: 2px 8px; font-size: 11px;">[clear log]</button>
    </div>
    <pre id="progress-feed">no active downloads.</pre>
</div>

<hr>

<h2>recent downloads <span id="history-count" style="color: var(--text-dim); font-size: 13px;"></span></h2>
<div class="library-toolbar" style="margin-bottom: 12px;">
    <button onclick="refreshHistory()">[refresh history]</button>
    <button onclick="clearHistory()">[clear history]</button>
    <input type="text" id="history-filter" placeholder="filter history..." oninput="filterHistory()" style="width: 220px;">
</div>
<div id="history-table-container">
    <p style="color: var(--text-muted);">loading history...</p>
</div>

<hr>

<h2>library <span id="library-count" style="color: var(--text-dim); font-size: 13px;"></span></h2>
<div class="library-toolbar">
    <button onclick="refreshLibrary()">[refresh library]</button>
    <input type="text" id="library-filter" placeholder="filter tracks..." oninput="filterLibrary()" style="width: 220px;">
</div>
<div id="library-list" class="library-list-box">
    <p style="color: var(--text-muted);">click refresh to load.</p>
</div>

<div id="status-text"></div>

<footer>
    <a href="https://github.com/athuull/hera" target="_blank" rel="noopener noreferrer" class="github-link" title="github: athuull/hera">
        <svg height="22" width="22" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
    </a>
</footer>

<script>
    let recommendations = [], searchResults = [], libraryData = [], historyData = [], ws = null;
    let resultMode = 'search';
    let batchState = {
        active: false,
        total: 0,
        completed: 0,
        failed: 0,
        skipped: 0,
        currentTrack: '',
        currentProgress: 0,
        currentStatus: 'idle'
    };

    function initTheme() {
        const saved = localStorage.getItem('hera-theme') || 'dark';
        applyTheme(saved);
    }

    function applyTheme(theme) {
        const btn = document.getElementById('theme-toggle-btn');
        if (theme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            if (btn) btn.innerText = '[dark mode]';
            localStorage.setItem('hera-theme', 'light');
        } else {
            document.documentElement.removeAttribute('data-theme');
            if (btn) btn.innerText = '[light mode]';
            localStorage.setItem('hera-theme', 'dark');
        }
    }

    function toggleTheme() {
        const isLight = document.documentElement.getAttribute('data-theme') === 'light';
        applyTheme(isLight ? 'dark' : 'light');
    }

    function updateTrackUI(name, percent, statusText, subtext, statusType = 'active') {
        const nameElem = document.getElementById('track-name-display');
        const fillElem = document.getElementById('track-progress-fill');
        const pctElem = document.getElementById('track-progress-pct');
        const pillElem = document.getElementById('track-status-pill');
        const subElem = document.getElementById('track-subtext');
        const cardElem = document.getElementById('card-track');

        const clamped = Math.max(0, Math.min(100, Math.round(percent || 0)));
        if (nameElem && name) { nameElem.innerText = name; nameElem.title = name; }
        if (fillElem) fillElem.style.width = `${clamped}%`;
        if (pctElem) pctElem.innerText = `${clamped}%`;
        if (pillElem && statusText) {
            pillElem.className = `status-pill ${statusType}`;
            pillElem.innerText = statusText;
        }
        if (subElem && subtext) subElem.innerText = subtext;
        if (cardElem) {
            if (statusType === 'active') cardElem.classList.add('active');
            else cardElem.classList.remove('active');
        }
    }

    function updateBatchUI(completed, total, smoothPercent, subtext, statusType = 'active') {
        const countElem = document.getElementById('batch-count-display');
        const fillElem = document.getElementById('batch-progress-fill');
        const pctElem = document.getElementById('batch-progress-pct');
        const pillElem = document.getElementById('batch-status-pill');
        const subElem = document.getElementById('batch-subtext');
        const cardElem = document.getElementById('card-batch');

        const clamped = Math.max(0, Math.min(100, Math.round(smoothPercent || 0)));
        if (countElem) countElem.innerText = `${completed} / ${total} tracks`;
        if (fillElem) fillElem.style.width = `${clamped}%`;
        if (pctElem) pctElem.innerText = `${clamped}%`;
        if (pillElem) {
            pillElem.className = `status-pill ${statusType}`;
            pillElem.innerText = statusType === 'active' ? '[● running]' : (statusType === 'connected' ? '[complete]' : '[idle]');
        }
        if (subElem && subtext) subElem.innerText = subtext;
        if (cardElem) {
            if (statusType === 'active') cardElem.classList.add('active');
            else cardElem.classList.remove('active');
        }
    }

    function startBatch(total) {
        if (batchState.active && batchState.total === total && batchState.completed === 0) {
            return;
        }
        batchState.active = true;
        batchState.total = Math.max(1, total || 1);
        batchState.completed = 0;
        batchState.failed = 0;
        batchState.skipped = 0;
        batchState.currentTrack = '';
        batchState.currentProgress = 0;
        batchState.currentStatus = 'downloading';
        setDownloadStatus(true, `[● batch of ${batchState.total}]`);
        updateTrackUI('preparing download...', 0, '[queued]', 'locating stream on youtube music...', 'active');
        updateBatchUI(0, batchState.total, 0, `remaining: ${batchState.total}`, 'active');
        logProgress(`started batch download of ${batchState.total} tracks...`);
    }

    function populateTimeDropdowns() {
        const h = document.getElementById('set-cron-hour'), m = document.getElementById('set-cron-minute');
        h.innerHTML = ''; m.innerHTML = '';
        for (let i = 0; i < 24; i++) h.add(new Option(i.toString().padStart(2, '0'), i));
        [0, 15, 30, 45].forEach(v => m.add(new Option(v.toString().padStart(2, '0'), v)));
    }

    function parseCron(cron) {
        if (!cron) return { hour: 2, minute: 0 };
        const p = cron.trim().split(/\s+/);
        return p.length >= 3 ? { minute: parseInt(p[1]) || 0, hour: parseInt(p[2]) || 0 } : { minute: 0, hour: 2 };
    }

    function buildCron() {
        return `0 ${document.getElementById('set-cron-minute').value} ${document.getElementById('set-cron-hour').value} * * *`;
    }

    function connectWS() {
        const proto = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsElem = document.getElementById('ws-text');
        ws = new WebSocket(`${proto}//${window.location.host}/ws/progress`);
        ws.onopen = () => { wsElem.className = 'status-pill connected'; wsElem.innerText = '[connected]'; };
        ws.onclose = () => { wsElem.className = 'status-pill disconnected'; wsElem.innerText = '[disconnected]'; setTimeout(connectWS, 3000); };
        ws.onerror = () => { wsElem.className = 'status-pill disconnected'; wsElem.innerText = '[error]'; };
        ws.onmessage = (e) => {
            try { handleWSMessage(JSON.parse(e.data)); }
            catch (err) { logProgress("ws: " + e.data); }
        };
    }

    function setDownloadStatus(active, text) {
        const elem = document.getElementById('download-status');
        if (!elem) return;
        elem.className = active ? 'status-pill active' : (text && (text.includes('complete') || text.includes('done') || text.includes('connected') || text.includes('success')) ? 'status-pill connected' : 'status-pill idle');
        elem.innerText = text || (active ? '[● downloading...]' : '[idle]');
    }

    function handleWSMessage(data) {
        if (data.type === 'batch_start') {
            startBatch(data.total);
            return;
        }

        if (data.type === 'batch_progress') {
            if (!batchState.active && data.total) {
                batchState.active = true;
                batchState.total = data.total;
            }
            if (data.completed !== undefined) {
                batchState.completed = data.completed;
                const smoothPct = batchState.total > 0 ? (batchState.completed / batchState.total) * 100 : 0;
                updateBatchUI(batchState.completed, batchState.total, smoothPct, `completed: ${batchState.completed} | remaining: ${Math.max(0, batchState.total - batchState.completed)}`, 'active');
            }
            return;
        }

        if (data.type === 'batch_complete') {
            batchState.active = false;
            const downloadedCount = data.downloaded !== undefined ? data.downloaded : Math.max(0, batchState.completed - batchState.failed - batchState.skipped);
            const failedCount = data.failed !== undefined ? Math.max(data.failed, batchState.failed) : batchState.failed;
            const skippedCount = data.skipped !== undefined ? Math.max(data.skipped, batchState.skipped) : batchState.skipped;
            const totalDone = data.total || (downloadedCount + failedCount + skippedCount) || batchState.total || 0;
            batchState.total = totalDone;
            batchState.completed = totalDone;
            setDownloadStatus(false, '[complete]');
            updateTrackUI(batchState.currentTrack || 'all tracks processed', 100, '[done]', 'all jobs completed', 'connected');
            updateBatchUI(totalDone, totalDone, 100, `finished: ${downloadedCount} downloaded, ${failedCount} failed${skippedCount ? `, ${skippedCount} skipped` : ''}`, 'connected');
            logProgress(`batch complete: ${downloadedCount} downloaded, ${failedCount} failed${skippedCount ? `, ${skippedCount} skipped` : ''}`);
            refreshLibrary();
            refreshHistory();
            setTimeout(() => {
                if (!batchState.active) {
                    setDownloadStatus(false, '[idle]');
                    const pillT = document.getElementById('track-status-pill');
                    const pillB = document.getElementById('batch-status-pill');
                    if (pillT) { pillT.className = 'status-pill idle'; pillT.innerText = '[idle]'; }
                    if (pillB) { pillB.className = 'status-pill idle'; pillB.innerText = '[idle]'; }
                    const cardT = document.getElementById('card-track');
                    const cardB = document.getElementById('card-batch');
                    if (cardT) cardT.classList.remove('active');
                    if (cardB) cardB.classList.remove('active');
                }
            }, 5000);
            const dlBtn = document.getElementById('download-selected-btn');
            if (dlBtn) { dlBtn.disabled = false; dlBtn.innerText = '[download selected]'; }
            return;
        }

        // Song level event
        const song = data.song || {};
        const songName = (song.artist && song.title) ? `${song.artist} - ${song.title}` : song.name || data.filename || data.message || 'track';
        const status = data.status || 'unknown';
        const progress = data.progress !== undefined ? data.progress : 0;

        if (status === 'downloading' || status === 'queued') {
            if (!batchState.active || batchState.completed >= batchState.total) {
                batchState.active = true;
                batchState.total = Math.max(1, batchState.total || 1);
                if (batchState.completed >= batchState.total) {
                    batchState.completed = 0;
                }
            }
            batchState.currentTrack = songName;
            batchState.currentProgress = progress;
            setDownloadStatus(true, `[● ${Math.round(progress)}%]`);
            updateTrackUI(songName, progress, `[● ${Math.round(progress)}%]`, 'downloading audio stream...', 'active');

            const smoothBatchPct = batchState.total > 0
                ? Math.min(99, ((batchState.completed + progress / 100) / batchState.total) * 100)
                : progress;
            const remaining = Math.max(0, batchState.total - batchState.completed - 1);
            updateBatchUI(batchState.completed, batchState.total, smoothBatchPct, `completed: ${batchState.completed} | remaining: ${remaining}`, 'active');
        } else if (status === 'finished' || status === 'done') {
            if (!batchState.active) {
                batchState.active = true;
                batchState.total = Math.max(1, batchState.total || 1);
            }
            if (batchState.completed < batchState.total) {
                batchState.completed = Math.min(batchState.total, batchState.completed + 1);
            }
            updateTrackUI(songName, 100, '[done]', 'downloaded and saved to library', 'connected');
            const batchPct = batchState.total > 0 ? (batchState.completed / batchState.total) * 100 : 100;
            updateBatchUI(batchState.completed, batchState.total, batchPct, `completed: ${batchState.completed} / ${batchState.total}`, batchState.completed >= batchState.total ? 'connected' : 'active');
            logProgress(`[done] ${songName}`);
            refreshLibrary();
            refreshHistory();
        } else if (status === 'skipped') {
            if (!batchState.active) {
                batchState.active = true;
                batchState.total = Math.max(1, batchState.total || 1);
            }
            batchState.skipped++;
            if (batchState.completed < batchState.total) {
                batchState.completed = Math.min(batchState.total, batchState.completed + 1);
            }
            updateTrackUI(songName, 100, '[skipped]', data.message || 'already in library', 'idle');
            const batchPct = batchState.total > 0 ? (batchState.completed / batchState.total) * 100 : 100;
            updateBatchUI(batchState.completed, batchState.total, batchPct, `skipped: ${songName} (already in library)`, 'active');
            logProgress(`[skipped] ${songName} (${data.message || 'already in library'})`);
            refreshHistory();
        } else if (status === 'error') {
            if (!batchState.active) {
                batchState.active = true;
                batchState.total = Math.max(1, batchState.total || 1);
            }
            batchState.failed++;
            if (batchState.completed < batchState.total) {
                batchState.completed = Math.min(batchState.total, batchState.completed + 1);
            }
            updateTrackUI(songName, 0, '[error]', data.message || 'download error', 'disconnected');
            const batchPct = batchState.total > 0 ? (batchState.completed / batchState.total) * 100 : 0;
            updateBatchUI(batchState.completed, batchState.total, batchPct, `failed: ${songName}`, 'active');
            logProgress(`[error] ${songName}: ${data.message || 'failed'}`);
            refreshHistory();
        }
    }

    function logProgress(msg) {
        const feed = document.getElementById('progress-feed');
        if (!feed) return;
        const ts = new Date().toTimeString().split(' ')[0];
        const line = `[${ts}] ${msg}`;
        if (feed.innerText === 'no active downloads.') {
            feed.innerText = line;
        } else {
            const lines = feed.innerText.split('\n');
            if (lines.length > 50) lines.pop();
            feed.innerText = line + '\n' + lines.join('\n');
        }
    }

    function clearProgress() {
        const feed = document.getElementById('progress-feed');
        if (feed) feed.innerText = 'no active downloads.';
        if (!batchState.active) {
            updateTrackUI('no active download', 0, '[idle]', 'waiting for download job...', 'idle');
            updateBatchUI(0, 0, 0, 'no active batch', 'idle');
            setDownloadStatus(false, '[idle]');
        }
    }

    function toggleSeedInput() {
        const s = document.getElementById('strategy').value;
        const g = document.getElementById('seed-group'), l = document.getElementById('seed-label'), i = document.getElementById('seed');
        const labels = { ARTIST_SIMILARITY: ['artist name:', 'radiohead'], TRACK_SIMILARITY: ['artist - track:', 'radiohead - paranoid android'], TAG_BASED: ['genre tag:', 'shoegaze'] };
        if (labels[s]) {
            g.classList.remove('hidden'); l.innerText = labels[s][0]; i.placeholder = labels[s][1];
        } else {
            g.classList.add('hidden'); i.value = '';
        }
    }

    function formatDuration(sec) {
        if (!sec || isNaN(sec)) return '-';
        const s = parseInt(sec);
        const m = Math.floor(s / 60);
        const rem = s % 60;
        return `${m}:${rem.toString().padStart(2, '0')}`;
    }

    function handleDirectInputKey(e) {
        if (e.key === 'Enter') {
            const val = (document.getElementById('direct-search-input').value || '').trim();
            if (val.startsWith('http://') || val.startsWith('https://')) {
                downloadByUrl();
            } else {
                handleDirectSearch();
            }
        }
    }

    async function handleDirectSearch() {
        const input = document.getElementById('direct-search-input');
        const query = (input.value || '').trim();
        const btn = document.getElementById('direct-search-btn');
        const statusEl = document.getElementById('direct-search-status');
        const tableContainer = document.getElementById('results-table');
        const headingEl = document.getElementById('results-heading');

        if (!query) {
            if (statusEl) {
                statusEl.style.color = 'var(--status-err)';
                statusEl.innerText = 'enter a song name';
                setTimeout(() => { statusEl.innerText = ''; }, 3000);
            }
            input.focus();
            return;
        }

        if (query.startsWith('http://') || query.startsWith('https://')) {
            downloadByUrl();
            return;
        }

        if (btn) { btn.disabled = true; btn.innerText = '[searching...]'; }
        if (headingEl) headingEl.innerText = `search: "${query}"`;
        document.getElementById('results-actions').classList.add('hidden');

        const frames = ['[⠋]', '[⠙]', '[⠹]', '[⠸]', '[⠼]', '[⠴]', '[⠦]', '[⠧]', '[⠇]', '[⠏]'];
        let idx = 0;
        tableContainer.innerHTML = `<div class="loading-pulse"><span id="search-spinner" class="spinner-frame">${frames[0]}</span> <span>searching youtube music for "${escapeHtml(query)}"...</span></div>`;
        const spinTimer = setInterval(() => {
            idx = (idx + 1) % frames.length;
            const el = document.getElementById('search-spinner');
            if (el) el.innerText = frames[idx];
        }, 80);

        try {
            const res = await fetch(`/api/search?query=${encodeURIComponent(query)}`);
            if (!res.ok) throw new Error(`http ${res.status}`);
            searchResults = await res.json();
            resultMode = 'search';
            renderSearchResults(searchResults);
        } catch (e) {
            tableContainer.innerHTML = `<p style="color: var(--status-err);">search failed: ${escapeHtml(e.message)}</p>`;
        } finally {
            clearInterval(spinTimer);
            if (btn) { btn.disabled = false; btn.innerText = '[search songs]'; }
        }
    }

    function renderSearchResults(songs) {
        const container = document.getElementById('results-table');
        const actions = document.getElementById('results-actions');
        if (!songs || songs.length === 0) {
            container.innerHTML = '<p style="color: var(--text-muted);">no songs found on youtube music. try different keywords.</p>';
            actions.classList.add('hidden');
            return;
        }
        actions.classList.remove('hidden');

        let html = `<div class="table-container"><table><thead><tr>
            <th style="width: 40px; text-align: center;"><input type="checkbox" id="select-all-header" onchange="selectAll(this.checked)"></th>
            <th style="width: 44px;"></th>
            <th>song / title</th>
            <th>artist</th>
            <th>album</th>
            <th style="width: 70px;">duration</th>
            <th style="width: 100px; text-align: center;">action</th>
        </tr></thead><tbody>`;

        songs.forEach((song, i) => {
            const title = song.name || song.title || 'unknown';
            const artist = Array.isArray(song.artists) ? song.artists.join(', ') : (song.artists || song.artist || 'unknown');
            const album = song.album_name || song.album || '-';
            const duration = formatDuration(song.duration);
            const cover = song.cover_url || '';
            const isExplicit = !!song.explicit;

            html += `<tr>
                <td style="text-align: center;"><input type="checkbox" class="track-check" data-index="${i}" onchange="updateSelectedCount()"></td>
                <td style="text-align: center;">
                    ${cover ? `<img src="${escapeHtml(cover)}" class="track-thumb" onerror="this.style.display='none'" alt="" />` : ''}
                </td>
                <td style="font-weight: 600; color: var(--heading-color);">
                    ${escapeHtml(title)}
                    ${isExplicit ? '<span class="status-badge failed" style="font-size: 10px; margin-left: 6px;">[e]</span>' : ''}
                </td>
                <td>${escapeHtml(artist)}</td>
                <td style="color: var(--text-muted);">${escapeHtml(album)}</td>
                <td style="color: var(--text-muted); font-size: 12.5px;">${escapeHtml(duration)}</td>
                <td style="text-align: center;">
                    <button id="dl-btn-${i}" onclick="downloadSingleSearchResult(${i})" style="padding: 3px 8px; font-size: 11.5px;">[download]</button>
                </td>
            </tr>`;
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;
        updateSelectedCount();
    }

    async function downloadSingleSearchResult(i) {
        const song = searchResults[i];
        if (!song) return;
        const artistStr = Array.isArray(song.artists) ? song.artists.join(', ') : (song.artists || song.artist || '');
        const titleStr = song.name || song.title || '';
        const track = { artist: artistStr, title: titleStr };

        const btn = document.getElementById(`dl-btn-${i}`);
        if (btn) { btn.disabled = true; btn.innerText = '[queuing...]'; }
        startBatch(1);
        try {
            const res = await fetch('/api/download/tracks', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ tracks: [track] })
            });
            if (!res.ok) throw new Error(`http ${res.status}`);
            if (btn) { btn.innerText = '[queued]'; }
        } catch (e) {
            alert(`download failed: ${e.message}`);
            if (btn) { btn.disabled = false; btn.innerText = '[download]'; }
            setDownloadStatus(false);
        }
    }

    async function searchRecommendations() {
        const strategy = document.getElementById('strategy').value;
        const seed = document.getElementById('seed').value.trim();
        const limit = parseInt(document.getElementById('limit').value) || 20;
        if (['ARTIST_SIMILARITY', 'TRACK_SIMILARITY', 'TAG_BASED'].includes(strategy) && !seed) {
            alert('enter a search term'); return;
        }

        const personalStrategies = ['HYBRID', 'USER_PERSONALIZED', 'NOW_LISTENING', 'GENRE_BASED'];
        if (personalStrategies.includes(strategy)) {
            const apiKey = document.getElementById('set-lastfm-key').value.trim();
            const username = document.getElementById('set-lastfm-user').value.trim();
            const tableContainer = document.getElementById('results-table');
            if (!apiKey || !username) {
                const missing = [];
                if (!apiKey) missing.push('last.fm api key');
                if (!username) missing.push('last.fm username');
                tableContainer.innerHTML = `<p style="color: var(--status-err);">
                    missing ${missing.join(' and ')}. open <a href="#" onclick="document.getElementById('settings-details').open = true; document.getElementById('${!apiKey ? 'set-lastfm-key' : 'set-lastfm-user'}').focus(); return false;" style="color: var(--status-warn); text-decoration: underline; cursor: pointer;">settings</a> to configure.
                </p>`;
                return;
            }
        }

        const btn = document.getElementById('search-btn');
        btn.disabled = true; btn.innerText = '[discovering...]';
        const headingEl = document.getElementById('results-heading');
        if (headingEl) headingEl.innerText = 'recommendations';
        const tableContainer = document.getElementById('results-table');
        document.getElementById('results-actions').classList.add('hidden');

        const frames = ['[⠋]', '[⠙]', '[⠹]', '[⠸]', '[⠼]', '[⠴]', '[⠦]', '[⠧]', '[⠇]', '[⠏]'];
        let idx = 0;
        tableContainer.innerHTML = `<div class="loading-pulse"><span id="search-spinner" class="spinner-frame">${frames[0]}</span> <span>discovering tracks via ${escapeHtml(strategy.toLowerCase().replace(/_/g, ' '))}...</span></div>`;
        const spinTimer = setInterval(() => {
            idx = (idx + 1) % frames.length;
            const el = document.getElementById('search-spinner');
            if (el) el.innerText = frames[idx];
        }, 80);

        try {
            const res = await fetch(buildSearchUrl(strategy, seed, limit));
            if (!res.ok) { const err = await res.json().catch(() => ({})); throw new Error(err.message || `http ${res.status}`); }
            recommendations = await res.json();
            resultMode = 'recommendations';
            renderResults(recommendations);
        } catch (e) {
            tableContainer.innerHTML = `<p style="color: var(--status-err);">discovery failed: ${escapeHtml(e.message)}</p>`;
        } finally {
            clearInterval(spinTimer);
            btn.disabled = false; btn.innerText = '[discover recommendations]';
        }
    }

    function buildSearchUrl(s, seed, limit) {
        const enc = encodeURIComponent;
        const u = seed ? `&username=${enc(seed)}` : '';
        switch (s) {
            case 'USER_PERSONALIZED': return `/api/recommend/personal?limit=${limit}${u}`;
            case 'NOW_LISTENING': return `/api/recommend/now?limit=${limit}${u}`;
            case 'GENRE_BASED': return `/api/recommend/genres?limit=${limit}${u}`;
            case 'HYBRID': return `/api/recommend/hybrid?limit=${limit}${u}`;
            case 'TRACK_SIMILARITY':
                const sp = seed.indexOf(' - ');
                if (sp === -1) { alert('format: artist - track'); throw new Error('invalid format'); }
                return `/api/recommend/track?artist=${enc(seed.slice(0, sp).trim())}&track=${enc(seed.slice(sp + 3).trim())}&limit=${limit}`;
            case 'TAG_BASED': return `/api/recommend/tag?tag=${enc(seed)}&limit=${limit}`;
            default: return `/api/recommend?artist=${enc(seed)}&limit=${limit}`;
        }
    }

    function renderResults(recs) {
        const container = document.getElementById('results-table');
        const actions = document.getElementById('results-actions');
        if (!recs || recs.length === 0) {
            container.innerHTML = '<p style="color: var(--text-muted);">no recommendations found. check settings.</p>';
            actions.classList.add('hidden');
            return;
        }
        actions.classList.remove('hidden');
        let html = `<div class="table-container"><table><thead><tr>
            <th style="width: 40px; text-align: center;"><input type="checkbox" id="select-all-header" onchange="selectAll(this.checked)"></th>
            <th>artist</th><th>track</th><th>source</th><th>match</th><th>listeners</th>
        </tr></thead><tbody>`;
        recs.forEach((r, i) => {
            const t = r.track || {};
            html += `<tr>
                <td style="text-align: center;"><input type="checkbox" class="track-check" data-index="${i}" onchange="updateSelectedCount()"></td>
                <td style="font-weight: 600; color: var(--heading-color);">${escapeHtml(t.artist)}</td>
                <td>${escapeHtml(t.title)}</td>
                <td><span class="tag-pill">${escapeHtml(r.sourceArtist || 'algorithm')}</span></td>
                <td>${Math.round((r.matchScore || 0.5) * 100)}%</td>
                <td style="color: var(--text-muted);">${(r.listenerCount || 0).toLocaleString()}</td>
            </tr>`;
        });
        container.innerHTML = html + '</tbody></table></div>';
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const count = document.querySelectorAll('.track-check:checked').length;
        const label = document.getElementById('selected-count-label');
        if (label) label.innerText = `(${count} selected)`;
    }

    async function downloadSelected() {
        const selected = [];
        if (resultMode === 'search') {
            document.querySelectorAll('.track-check:checked').forEach(cb => {
                const song = searchResults[parseInt(cb.dataset.index)];
                if (song) {
                    const artistStr = Array.isArray(song.artists) ? song.artists.join(', ') : (song.artists || song.artist || '');
                    const titleStr = song.name || song.title || '';
                    selected.push({ artist: artistStr, title: titleStr });
                }
            });
        } else {
            document.querySelectorAll('.track-check:checked').forEach(cb => {
                const r = recommendations[parseInt(cb.dataset.index)];
                if (r && r.track) selected.push({ artist: r.track.artist, title: r.track.title });
            });
        }

        if (selected.length === 0) { alert('select at least one track'); return; }
        const btn = document.getElementById('download-selected-btn');
        if (btn) { btn.disabled = true; btn.innerText = `[queuing ${selected.length}...]`; }
        startBatch(selected.length);
        try {
            const res = await fetch('/api/download/tracks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ tracks: selected }) });
            if (!res.ok) throw new Error(`http ${res.status}`);
            if (btn) btn.innerText = '[downloading...]';
        } catch (e) {
            alert(`download failed: ${e.message}`);
            if (btn) { btn.disabled = false; btn.innerText = '[download selected]'; }
            setDownloadStatus(false);
        }
    }

    async function downloadByUrl() {
        const input = document.getElementById('direct-search-input');
        const btn = document.getElementById('download-url-btn');
        const statusEl = document.getElementById('direct-search-status');
        const url = input.value.trim();

        if (!url) {
            if (statusEl) {
                statusEl.style.color = 'var(--status-err)';
                statusEl.innerText = 'please paste a link or song name';
                setTimeout(() => { statusEl.innerText = ''; }, 3000);
            }
            input.focus();
            return;
        }

        if (!url.startsWith('http://') && !url.startsWith('https://')) {
            handleDirectSearch();
            return;
        }

        if (btn) { btn.disabled = true; btn.innerText = '[queuing...]'; }
        if (statusEl) { statusEl.style.color = 'var(--text-muted)'; statusEl.innerText = 'processing link...'; }
        startBatch(1);

        try {
            const res = await fetch('/api/download/url', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url: url })
            });
            if (!res.ok) {
                const errData = await res.json().catch(() => ({}));
                throw new Error(errData.error || `http ${res.status}`);
            }
            if (btn) { btn.innerText = '[queued]'; }
            if (statusEl) {
                statusEl.style.color = 'var(--status-ok)';
                statusEl.innerText = 'download queued';
            }
            logProgress(`system: download queued for link -> ${url}`);
            input.value = '';
            setDownloadStatus(true);
            setTimeout(() => {
                if (btn) { btn.disabled = false; btn.innerText = '[download link]'; }
                if (statusEl && statusEl.innerText.includes('queued')) { statusEl.innerText = ''; }
            }, 3000);
        } catch (e) {
            if (btn) { btn.disabled = false; btn.innerText = '[download link]'; }
            if (statusEl) {
                statusEl.style.color = 'var(--status-err)';
                statusEl.innerText = `✗ error: ${e.message}`;
                setTimeout(() => { statusEl.innerText = ''; }, 4000);
            }
            setDownloadStatus(false);
        }
    }

    async function refreshLibrary() {
        const list = document.getElementById('library-list');
        list.innerHTML = '<p style="color: var(--text-muted);">loading...</p>';
        try {
            const res = await fetch('/api/library');
            if (!res.ok) throw new Error(`http ${res.status}`);
            libraryData = await res.json();
            const count = document.getElementById('library-count');
            if (count) count.innerText = `(${libraryData.length} tracks)`;
            renderLibrary(libraryData);
        } catch (e) {
            list.innerHTML = `<p style="color: var(--status-err);">error: ${escapeHtml(e.message)}</p>`;
        }
    }

    function renderLibrary(files) {
        const list = document.getElementById('library-list');
        if (!files || files.length === 0) { list.innerHTML = '<p style="color: var(--text-muted);">no files downloaded yet.</p>'; return; }
        list.innerHTML = '<ul>' + files.map(f => {
            const name = f.replace(/\\/g, '/').split('/').pop();
            const coverUrl = `/api/cover?file=${encodeURIComponent(f)}`;
            return `<li><img data-src="${coverUrl}" class="track-thumb track-thumb-lazy" onerror="this.style.display='none'" alt="" /><span>${escapeHtml(name)}</span></li>`;
        }).join('') + '</ul>';
        observeLazyCovers();
    }

    function observeLazyCovers() {
        const imgs = document.querySelectorAll('.track-thumb-lazy');
        if (!imgs.length) return;
        if (!('IntersectionObserver' in window)) {
            imgs.forEach(img => { img.src = img.dataset.src; img.classList.remove('track-thumb-lazy'); });
            return;
        }
        const observer = new IntersectionObserver((entries, obs) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const img = entry.target;
                    img.src = img.dataset.src;
                    img.classList.remove('track-thumb-lazy');
                    obs.unobserve(img);
                }
            });
        }, { root: document.getElementById('library-list'), rootMargin: '100px' });
        imgs.forEach(img => observer.observe(img));
    }

    function filterLibrary() {
        const q = (document.getElementById('library-filter').value || '').toLowerCase();
        renderLibrary(libraryData.filter(f => f.toLowerCase().includes(q)));
    }

    async function triggerSchedule() {
        const btn = document.querySelector('button[onclick="triggerSchedule()"]');
        if (btn) { btn.disabled = true; btn.innerText = '[triggering...]'; }
        setDownloadStatus(true, '[● auto-download active...]');
        try {
            const res = await fetch('/api/schedule/trigger', { method: 'POST' });
            if (!res.ok) throw new Error(`http ${res.status}`);
            logProgress('system: triggered scheduled download pipeline');
        } catch (e) {
            alert(`sync trigger failed: ${e.message}`);
            setDownloadStatus(false);
        } finally {
            if (btn) { btn.disabled = false; btn.innerText = '[auto-download now]'; }
        }
    }

    async function triggerCleanup() {
        const btn = document.getElementById('cleanup-btn');
        const statusEl = document.getElementById('settings-status');
        if (btn) { btn.disabled = true; btn.innerText = '[cleaning...]'; }
        if (statusEl) { statusEl.style.color = 'var(--text-muted)'; statusEl.innerText = 'cleaning .webm files...'; }
        try {
            logProgress('system: starting .webm to .mp3 format cleanup...');
            const res = await fetch('/api/cleanup', { method: 'POST' });
            if (!res.ok) throw new Error(`http ${res.status}`);
            const converted = await res.json();
            logProgress(`system: cleanup finished. converted ${converted.length} files`);
            if (statusEl) {
                statusEl.style.color = 'var(--status-ok)';
                statusEl.innerText = `converted ${converted.length} files`;
                setTimeout(() => { statusEl.innerText = ''; }, 3500);
            }
            refreshLibrary();
        } catch (e) {
            if (statusEl) {
                statusEl.style.color = 'var(--status-err)';
                statusEl.innerText = `✗ cleanup failed: ${e.message}`;
                setTimeout(() => { statusEl.innerText = ''; }, 4000);
            }
            alert(`cleanup failed: ${e.message}`);
        } finally {
            if (btn) { btn.disabled = false; btn.innerText = '[cleanup webm]'; }
        }
    }

    async function openSettings() {
        try {
            const res = await fetch('/api/settings');
            if (!res.ok) throw new Error('failed to load settings');
            const s = await res.json();
            document.getElementById('set-lastfm-key').value = s.lastfmApiKey || '';
            document.getElementById('set-lastfm-user').value = s.lastfmUsername || '';
            document.getElementById('set-max-downloads').value = s.maxDailyDownloads || 5;
            document.getElementById('set-strategy').value = s.scheduledStrategy || 'HYBRID';
            const t = parseCron(s.cronSchedule || '0 0 2 * * *');
            document.getElementById('set-cron-hour').value = t.hour;
            document.getElementById('set-cron-minute').value = t.minute;
            document.getElementById('set-format').value = s.format || 'mp3';
            document.getElementById('set-bitrate').value = s.bitrate || '320';
            document.getElementById('set-organize').checked = !!s.organizeByArtist;
            document.getElementById('set-lyrics').checked = !!s.downloadLyrics;
            document.getElementById('set-cover-art').checked = s.downloadCoverArt !== false;
            document.getElementById('set-cover-resolution').value = s.coverResolution || 600;
        } catch (e) { console.error('error loading settings:', e); }
    }

    async function saveSettings() {
        const btn = document.getElementById('save-settings-btn');
        const statusEl = document.getElementById('settings-status');
        if (btn) { btn.disabled = true; btn.innerText = '[saving...]'; }
        if (statusEl) { statusEl.style.color = 'var(--text-muted)'; statusEl.innerText = 'saving...'; }

        const s = {
            lastfmApiKey: document.getElementById('set-lastfm-key').value.trim(),
            lastfmUsername: document.getElementById('set-lastfm-user').value.trim(),
            maxDailyDownloads: parseInt(document.getElementById('set-max-downloads').value) || 5,
            scheduledStrategy: document.getElementById('set-strategy').value,
            cronSchedule: buildCron(),
            format: document.getElementById('set-format').value,
            bitrate: document.getElementById('set-bitrate').value,
            organizeByArtist: document.getElementById('set-organize').checked,
            downloadLyrics: document.getElementById('set-lyrics').checked,
            downloadCoverArt: document.getElementById('set-cover-art').checked,
            coverResolution: parseInt(document.getElementById('set-cover-resolution').value) || 600
        };
        try {
            const res = await fetch('/api/settings', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(s) });
            if (!res.ok) throw new Error('failed to save settings');
            if (btn) { btn.innerText = '[saved]'; }
            if (statusEl) {
                statusEl.style.color = 'var(--status-ok)';
                statusEl.innerText = 'settings saved and applied.';
            }
            logProgress('system: settings updated and applied.');
            const el = document.getElementById('status-text');
            if (el) {
                el.innerText = 'settings saved and applied.';
                setTimeout(() => { el.innerText = ''; }, 3500);
            }
            setTimeout(() => {
                if (btn) { btn.disabled = false; btn.innerText = '[save settings]'; }
                if (statusEl && statusEl.innerText.includes('saved')) { statusEl.innerText = ''; }
            }, 2500);
        } catch (e) {
            if (btn) { btn.disabled = false; btn.innerText = '[save settings]'; }
            if (statusEl) {
                statusEl.style.color = 'var(--status-err)';
                statusEl.innerText = `✗ error: ${e.message}`;
                setTimeout(() => { statusEl.innerText = ''; }, 4000);
            }
            alert(`error saving settings: ${e.message}`);
        }
    }

    async function refreshHistory() {
        const container = document.getElementById('history-table-container');
        try {
            const res = await fetch('/api/history?limit=100');
            if (!res.ok) throw new Error(`http ${res.status}`);
            historyData = await res.json();
            const countEl = document.getElementById('history-count');
            if (countEl) countEl.innerText = `(${historyData.length} records)`;
            renderHistory(historyData);
        } catch (e) {
            container.innerHTML = `<p style="color: var(--status-err);">error loading history: ${escapeHtml(e.message)}</p>`;
        }
    }

    function renderHistory(items) {
        const container = document.getElementById('history-table-container');
        if (!items || items.length === 0) {
            container.innerHTML = '<p style="color: var(--text-muted);">no download history recorded yet.</p>';
            return;
        }

        let html = `<div class="table-container"><table><thead><tr>
            <th style="width: 140px;">time</th>
            <th>track / title</th>
            <th>artist</th>
            <th>source</th>
            <th>reason</th>
            <th style="width: 90px; text-align: center;">status</th>
        </tr></thead><tbody>`;

        items.forEach(item => {
            const timeStr = formatHistoryTime(item.timestamp);
            const statusClass = (item.status || '').toLowerCase() === 'success' ? 'success' : ((item.status || '').toLowerCase() === 'failed' ? 'failed' : 'skipped');
            const statusLabel = (item.status || '').toLowerCase() === 'success' ? '[success]' : ((item.status || '').toLowerCase() === 'failed' ? '[failed]' : '[skipped]');
            const sourceLabel = formatSourceLabel(item.source);
            const displayTitle = item.title || item.filename || 'unknown';
            const displayArtist = item.artist || '-';

            html += `<tr>
                <td style="color: var(--text-muted); font-size: 12px; white-space: nowrap;">${escapeHtml(timeStr)}</td>
                <td style="font-weight: 600; color: var(--heading-color);">${escapeHtml(displayTitle)}</td>
                <td>${escapeHtml(displayArtist)}</td>
                <td><span class="source-badge">${escapeHtml(sourceLabel)}</span></td>
                <td style="color: var(--text-muted); font-size: 12px;">${escapeHtml(item.reason || '-')}</td>
                <td style="text-align: center;"><span class="status-badge ${statusClass}">${escapeHtml(statusLabel)}</span></td>
            </tr>`;
        });

        html += '</tbody></table></div>';
        container.innerHTML = html;
    }

    function formatHistoryTime(iso) {
        if (!iso) return '-';
        try {
            const date = new Date(iso);
            if (isNaN(date.getTime())) return iso;
            const now = new Date();
            const diffMs = now - date;
            const diffMin = Math.floor(diffMs / 60000);
            const diffHr = Math.floor(diffMin / 60);

            if (diffMin < 1) return 'just now';
            if (diffMin < 60) return `${diffMin}m ago`;
            if (diffHr < 24) return `${diffHr}h ago`;

            return date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' }) + ' ' +
                   date.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
        } catch (e) {
            return iso;
        }
    }

    function formatSourceLabel(source) {
        if (!source) return 'unknown';
        switch (source) {
            case 'NIGHTLY_AUTO': return 'nightly auto';
            case 'MANUAL_SEARCH': return 'manual';
            case 'URL_IMPORT': return 'link import';
            default: return source.toLowerCase().replace(/_/g, ' ');
        }
    }

    function filterHistory() {
        const q = (document.getElementById('history-filter').value || '').toLowerCase();
        if (!q) {
            renderHistory(historyData);
            return;
        }
        const filtered = historyData.filter(item => {
            return (item.title && item.title.toLowerCase().includes(q)) ||
                   (item.artist && item.artist.toLowerCase().includes(q)) ||
                   (item.filename && item.filename.toLowerCase().includes(q)) ||
                   (item.reason && item.reason.toLowerCase().includes(q)) ||
                   (item.source && item.source.toLowerCase().includes(q)) ||
                   (item.status && item.status.toLowerCase().includes(q));
        });
        renderHistory(filtered);
    }

    async function clearHistory() {
        if (!confirm('clear all download history?')) return;
        try {
            const res = await fetch('/api/history', { method: 'DELETE' });
            if (!res.ok) throw new Error(`http ${res.status}`);
            historyData = [];
            const countEl = document.getElementById('history-count');
            if (countEl) countEl.innerText = '(0 records)';
            renderHistory([]);
            logProgress('system: download history cleared');
        } catch (e) {
            alert(`failed to clear history: ${e.message}`);
        }
    }

    function selectAll(checked) {
        document.querySelectorAll('.track-check').forEach(cb => cb.checked = checked);
        const h = document.getElementById('select-all-header');
        if (h) h.checked = checked;
        updateSelectedCount();
    }

    function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str || '';
        return d.innerHTML;
    }

    window.addEventListener('DOMContentLoaded', () => {
        initTheme();
        populateTimeDropdowns();
        connectWS();
        toggleSeedInput();
        openSettings();
        refreshHistory();
        refreshLibrary();
    });
</script>
</body>
</html>